# ==============================================================================
# Knowledge Routing RAG v0 - Environment Configuration
# ==============================================================================

# --- DeepSeek LLM API Settings ---
# DeepSeek API Key (Required for Generator, K3 Segment Planner, K4 Gap Detector)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_CONCURRENCY=5

# --- Local Docker Embedding Service Settings ---
# Running via docker-compose (TEI / Infinity / Xinference / Ollama)
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=dummy-token-not-needed
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30

# --- Vector Database (Qdrant Docker) Settings ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge_routing_exp

# --- SQLite & FTS5 Settings ---
SQLITE_DB_PATH=data/knowledge_lsdb.sqlite

# --- Network & Proxy Settings ---
# Set according to your local proxy client (e.g. Clash, Surge, v2ray)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,0.0.0.0,embedding,qdrant

# --- Routing Budget & Safety Constraints (Locked across D20/D50/D100) ---
MAX_EVIDENCE_TOKENS=4000
SEED_TOP_K=5
MAX_BRANCH_PER_NODE=2
MAX_HOPS=3
MAX_PATHS=6
MAX_FINAL_EVIDENCE=6
MAX_ACTIVE_FALLBACKS=2
HUB_DEGREE_FLOOR=6

# --- Logging & Tracing ---
LOG_LEVEL=INFO
TRACES_DIR=runs
REPORTS_DIR=reports
